system/com.cantrell.inference-lab.server = {
	active count = 1
	path = /Library/LaunchDaemons/com.cantrell.inference-lab.server.plist
	type = LaunchDaemon
	state = running

	program = /Users/jakecantrell/inference-lab/service/start-inference.sh
	arguments = {
		/Users/jakecantrell/inference-lab/service/start-inference.sh
	}

	working directory = /Users/jakecantrell/inference-lab

	stdout path = /dev/null
	stderr path = /dev/null
	default environment = {
		PATH => /usr/bin:/bin:/usr/sbin:/sbin
	}

	environment = {
		OSLogRateLimit => 64
		USER => jakecantrell
		SUSHI_NGRAM_WARM => 0
		MLX_SERVE_NGRAM_WARM => 0
		PATH => /usr/bin:/bin:/usr/sbin:/sbin
		LOGNAME => jakecantrell
		APC_ENABLED => 0
		LLAMA_ARG_TEMPERATURE => 0
		HOME => /Users/jakecantrell
		APC_DISK_ENABLED => 0
		XPC_SERVICE_NAME => com.cantrell.inference-lab.server
	}

	domain = system
	username = jakecantrell

	minimum runtime = 10
	exit timeout = 5
	runs = 1
	pid = 4158
	immediate reason = speculative
	forks = 3
	execs = 4
	initialized = 1
	trampolined = 1
	started suspended = 0
	proxy started suspended = 0
	checked allocations = 0 (queried = 1)
	checked allocations reason = no host
	checked allocations flags = 0x0
	last exit code = (never exited)

	resource coalition = {
		ID = 7911
		type = resource
		state = active
		active count = 1
		name = com.cantrell.inference-lab.server
	}

	jetsam coalition = {
		ID = 7912
		type = jetsam
		state = active
		active count = 1
		name = com.cantrell.inference-lab.server
	}

	spawn type = daemon (3)
	jetsam priority = 40
	jetsam memory limit (active) = (unlimited)
	jetsam memory limit (inactive) = (unlimited)
	jetsamproperties category = daemon
	jetsam thread limit = 32
	cpumon = default
	sanitizer flags = 0x0

	properties = keepalive | runatload | inferred program | system service | tle system
}
